# Copiá este archivo a .env y ajustá lo que quieras.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Token que deben mandar los clientes MCP como "Authorization: Bearer <token>"
MCP_GRAFANA_SERVER_TOKEN=demo-token-cambiame

# Opcional (recomendado): service account de Grafana con rol Viewer.
# Si lo dejás vacío, el MCP usa usuario/contraseña de admin.
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Versiones de imágenes (fijalas si vas a repetir la demo)
GRAFANA_VERSION=latest
LOKI_VERSION=3.5.0
ALLOY_VERSION=latest
VM_VERSION=latest
MCP_GRAFANA_VERSION=latest
