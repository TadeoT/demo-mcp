{
  "mcpServers": {
    "grafana": {
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "--network", "grafana-mcp-demo_default",
        "-e", "GRAFANA_URL",
        "-e", "GRAFANA_USERNAME",
        "-e", "GRAFANA_PASSWORD",
        "grafana/mcp-grafana",
        "-t", "stdio",
        "--disable-write"
      ],
      "env": {
        "GRAFANA_URL": "http://grafana:3000",
        "GRAFANA_USERNAME": "admin",
        "GRAFANA_PASSWORD": "admin"
      }
    }
  }
}
